@{
    ViewBag.Title = "افزودن عضو";
}

<a href="/Members/Index/@ViewBag.ProjectId">&larr; بازگشت به مدیریت اعضا</a>

<h2>افزودن عضو</h2>

<form method="post">
    <input type="hidden" name="projectId" value="@ViewBag.ProjectId" />

    <div>
        <label>کاربر:</label>
        <select name="userId">
            @foreach (var u in (List<TaskManagementWeb.Models.Users>)ViewBag.AvailableUsers)
            {
                <option value="@u.Id">@u.Name</option>
            }
        </select>
    </div>

    <div>
        <label>نقش:</label>
        <select name="role">
            <option value="Member">Member</option>
            <option value="Admin">Admin</option>
            <option value="Owner">Owner</option>
        </select>
    </div>

    <button type="submit">افزودن</button>
</form>