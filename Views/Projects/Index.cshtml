@model List<TaskManagementWeb.Models.ProjectRow>

@{
    ViewBag.Title = "پروژه‌های من";
}

<h2>پروژه‌های من</h2>

<p><a href="/Projects/Create">+ پروژه جدید</a></p>

<table border="1" cellpadding="8">
    <tr>
        <th>عنوان</th>
        <th>توضیحات</th>
        <th>نقش من</th>
        <th></th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Title</td>
            <td>@p.Description</td>
            <td>@p.Role</td>
            <td>
                @if (p.Role == "Owner")
                {
                    <a href="/Projects/Edit/@p.Id">ویرایش</a>
                }
                <a href="/Tasks/Index/@p.Id">ورود به پروژه</a>
            </td>
            <td>
    @if (p.Role == "Owner")
    {
        <a href="/Projects/Edit/@p.Id">ویرایش</a>

        <form method="post" action="/Projects/Delete" style="display:inline"
              onsubmit="return confirm('با حذف پروژه، همه‌ی تسک‌ها و اعضای اون هم حذف می‌شن. مطمئنی؟');">
            <input type="hidden" name="projectId" value="@p.Id" />
            <button type="submit">حذف</button>
        </form>
    }
    <a href="/Tasks/Index/@p.Id">ورود به پروژه</a>
</td>
        </tr>
    }
</table>