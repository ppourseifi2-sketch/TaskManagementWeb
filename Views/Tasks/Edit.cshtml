@model TaskManagementWeb.Models.TasksEditViewModel

@{
    ViewBag.Title = "تسک";
}

<h2>@(Model.Task.Id == 0 ? "تسک جدید" : "ویرایش تسک")</h2>

<form method="post">
    <input type="hidden" name="projectId" value="@Model.ProjectId" />
    <input type="hidden" name="taskId" value="@(Model.Task.Id == 0 ? "" : Model.Task.Id.ToString())" />

    <div>
        <label>عنوان:</label>
        <input type="text" name="title" value="@Model.Task.Title" />
    </div>

    <div>
        <label>توضیحات:</label>
        <textarea name="description">@Model.Task.Description</textarea>
    </div>

    <div>
        <label>وضعیت:</label>
        <select name="status">
            <option value="To Do" selected="@(Model.Task.Status == "To Do")">To Do</option>
            <option value="In Progress" selected="@(Model.Task.Status == "In Progress")">In Progress</option>
            <option value="Done" selected="@(Model.Task.Status == "Done")">Done</option>
        </select>
    </div>

    <div>
        <label>مسئول:</label>
        <select name="assignedUserId">
            <option value="">(بدون تخصیص)</option>
            @foreach (var u in Model.ProjectUsers)
            {
                <option value="@u.Id" selected="@(Model.Task.AssignedUserId == u.Id)">@u.Name</option>
            }
        </select>
    </div>

    <button type="submit">ذخیره</button>
</form>